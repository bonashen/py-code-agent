# Py Code Agent Environment Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
PY_LLM_PROVIDER=openai
PY_LLM_MODEL=Qwen3-32B
PY_LLM_API_KEY=your-api-key-here
PY_LLM_BASE_URL=http://your-api-endpoint.com/v1
PY_LLM_TIMEOUT=60
PY_LLM_MAX_RETRIES=3
PY_LLM_TEMPERATURE=0.7
PY_LLM_MAX_TOKENS=4000
PY_LLM_DEBUG=false
PY_LLM_VERBOSE=false

# Tool Configuration
PY_TOOLS_ALLOW_BASH=true
PY_TOOLS_ALLOW_FILE_WRITE=true
PY_TOOLS_TIMEOUT=30

# UI Configuration
PY_UI_THEME=dark
PY_UI_SHOW_TOOL_CALLS=true
PY_UI_STREAM_OUTPUT=true
PY_UI_HISTORY_SIZE=1000

# React Configuration
PY_REACT_ENABLED=true
PY_REACT_MAX_TURNS=50

# Heartbeat Configuration
PY_HEARTBEAT_ENABLED=true
PY_HEARTBEAT_INTERVAL=30
PY_HEARTBEAT_TIMEOUT=90

# Channel Configuration
PY_CHANNEL_WEB_HOST=0.0.0.0
PY_CHANNEL_WEB_PORT=8080
PY_CHANNEL_WEB_REQUIRE_AUTH=false
